        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "myota_outbox_unresolved_dead_letters",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Activity asynchronous jobs",
      "description": "Database-backed Activity work state by fixed work kind and status.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind) (myota_activity_jobs_total{status=\"queued\"})",
          "legendFormat": "{{kind}} queued",
          "refId": "A"
        },
        {
          "expr": "sum by (kind) (myota_activity_jobs_total{status=\"running\"})",
          "legendFormat": "{{kind}} running",
          "refId": "B"
        },
        {
          "expr": "sum by (kind) (myota_activity_jobs_total{status=\"failed\"})",
          "legendFormat": "{{kind}} failed",
          "refId": "C"
        }
      ]
    },
