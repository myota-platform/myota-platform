{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myota-platform/myota-contracts/contracts/schemas/event-envelope.schema.json",
  "title": "MyOTA immutable domain event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelopeVersion", "eventId", "eventType", "occurredAt", "producer", "aggregate", "payload"],
  "properties": {
    "envelopeVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$" },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producer": { "type": "string", "minLength": 1, "maxLength": 80 },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "correlationId": { "type": "string", "maxLength": 200 },
    "causationId": { "type": "string", "maxLength": 200 },
    "payload": { "type": "object", "description": "Per-event payload schema is referenced by the registry; payload shape evidence is incomplete for some Phase 0 rows." }
  }
}
