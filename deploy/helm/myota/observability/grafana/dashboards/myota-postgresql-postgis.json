    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "title": "Geodata capacity dashboard",
      "tooltip": "Geodata workload and PostGIS service metrics",
      "type": "link",
      "url": "/observability/d/myota-geodata-capacity"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Database connections",
      "description": "Current client backend count from the bounded read-only Operations sampler; labels use only the fixed database names.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "myota_postgresql_connections{database=\"core\"}",
          "legendFormat": "core",
          "refId": "A"
        },
        {
          "expr": "myota_postgresql_connections{database=\"activity\"}",
          "legendFormat": "activity",
          "refId": "B"
        },
        {
          "expr": "myota_postgresql_connections{database=\"geo\"}",
          "legendFormat": "geo",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Database size",
      "description": "Trend only; establish representative growth before setting capacity triggers.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "myota_postgresql_database_size_bytes{database=\"core\"}",
          "legendFormat": "core",
          "refId": "A"
        },
        {
          "expr": "myota_postgresql_database_size_bytes{database=\"activity\"}",
          "legendFormat": "activity",
          "refId": "B"
        },
        {
          "expr": "myota_postgresql_database_size_bytes{database=\"geo\"}",
          "legendFormat": "geo",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Commit rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(myota_postgresql_commits_total{database=\"core\"}[5m])",
          "legendFormat": "core",
          "refId": "A"
        },
        {
          "expr": "rate(myota_postgresql_commits_total{database=\"activity\"}[5m])",
          "legendFormat": "activity",
          "refId": "B"
        },
        {
          "expr": "rate(myota_postgresql_commits_total{database=\"geo\"}[5m])",
          "legendFormat": "geo",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rollback rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(myota_postgresql_rollbacks_total{database=\"core\"}[5m])",
          "legendFormat": "core",
          "refId": "A"
        },
        {
          "expr": "rate(myota_postgresql_rollbacks_total{database=\"activity\"}[5m])",
          "legendFormat": "activity",
          "refId": "B"
        },
        {
          "expr": "rate(myota_postgresql_rollbacks_total{database=\"geo\"}[5m])",
          "legendFormat": "geo",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Deadlocks",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(myota_postgresql_deadlocks_total{database=\"core\"}[5m])",
          "legendFormat": "core",
          "refId": "A"
        },
        {
          "expr": "rate(myota_postgresql_deadlocks_total{database=\"activity\"}[5m])",
          "legendFormat": "activity",
          "refId": "B"
        },
        {
          "expr": "rate(myota_postgresql_deadlocks_total{database=\"geo\"}[5m])",
          "legendFormat": "geo",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PostGIS query latency p95",
      "description": "Bounded Geodata application histogram; it reports Geo query latency only and never contains SQL text.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, query) (rate(myota_geodata_postgis_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{query}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connection utilization",
      "description": "Connections divided by configured max_connections from the same bounded DB sampler. Missing series are not zero.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * myota_postgresql_connections / on(database) myota_postgresql_max_connections",
          "legendFormat": "{{database}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Geodata connection pool waiters",
      "description": "Current application-side pool waiters; this is a Geodata pool value, not all database clients.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "myota_geodata_postgres_pool_waiting_requests",
          "legendFormat": "waiting requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Geodata PostgreSQL lock waits",
      "description": "Current connections waiting on database locks, measured by the Geodata application.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "myota_geodata_postgres_lock_waiting_connections",
          "legendFormat": "waiting connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Geodata connection pool wait duration",
      "description": "Five-minute rate of application-observed pool wait time, converted from milliseconds to seconds per second.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(myota_geodata_postgres_pool_wait_milliseconds_total[5m]) / 1000",
          "legendFormat": "Geodata pool wait seconds/second",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "Unsupported database signals",
      "description": "Metrics intentionally absent from the current least-privilege source are identified explicitly.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "options": {
        "mode": "markdown",
        "content": "The current supported metric source does **not** export transaction age, cache hit ratio, autovacuum/freeze age, or per-table maintenance state. They are unavailable, not zero. No panel is drawn for these signals. PostgreSQL panels use fixed database labels and no SQL text, parameters, credentials, or user identifiers. The read-only Operations sampler remains the source while its migration/retirement work is tracked separately."
      }
    }
  ],
  "refresh": "30s",
