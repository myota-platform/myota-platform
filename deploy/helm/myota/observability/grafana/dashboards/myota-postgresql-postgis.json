  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Database connections",
      "description": "Current client backends per MyOTA database.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "myota_postgresql_connections{database=\"core\"}",
          "legendFormat": "myota_core",
          "refId": "A"
        },
        {
          "expr": "myota_postgresql_connections{database=\"activity\"}",
          "legendFormat": "myota_activity",
          "refId": "B"
        },
        {
          "expr": "myota_postgresql_connections{database=\"geo\"}",
          "legendFormat": "myota_geo",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
