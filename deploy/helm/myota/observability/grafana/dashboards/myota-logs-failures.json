    {
      "id": 1,
      "title": "Log events per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_namespace=\"myota\"} | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\" | severity_text=~\"${severity:regex}\" | component=~\"${component:regex}\" | correlation_id=~\"${correlation_id:regex}\"[1m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "Warnings and errors per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (rate({service_namespace=\"myota\"} | severity_text=~\"WARN|ERROR\" | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\" | component=~\"${component:regex}\"[5m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
