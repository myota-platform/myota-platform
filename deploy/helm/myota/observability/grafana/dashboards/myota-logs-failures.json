          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
